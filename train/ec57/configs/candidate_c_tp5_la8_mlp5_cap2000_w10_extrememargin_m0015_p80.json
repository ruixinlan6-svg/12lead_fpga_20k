{
  "candidate_name": "candidate_c_tp5_la8_mlp5_cap2000_w10_extrememargin_m0015_p80",
  "description": "5-bin temporal model, 8 lookahead features, MLP hidden 5, cap 2000, lr 3e-4, extreme margin loss (margin 0.015, penalty 8.0), AP checkpoint selection",
  "model": {
