{
  "candidate_name": "candidate_twostage_m4c_cand3_dualbranch_m24_t24_margin_m0025",
  "description": "DualBranch Architecture M4c: 24-dim Morph + 24-dim Timing, Gated Fusion, Asymmetric Margin Loss (margin=0.025, penalty=4.0), Se>=90% Selection",
  "model": {
