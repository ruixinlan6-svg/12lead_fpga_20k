// =============================================================================
// Physical Constraints (.cst) for Tang Nano 20K (GW2AR-LV18QN88PC8/I7)
// =============================================================================

// 27MHz Onboard Active Crystal Oscillator
IO_LOC "clk" 4;
IO_PORT "clk" PULL_MODE=NONE;

// User Button S1 (0 = Released/Normal, 1 = Pressed/Reset)
IO_LOC "rst_btn" 88;
IO_PORT "rst_btn" PULL_MODE=DOWN;

// Onboard User LEDs (Active-Low: 0=ON, 1=OFF)
IO_LOC "led[0]" 15;
IO_PORT "led[0]" DRIVE=8;

IO_LOC "led[1]" 16;
IO_PORT "led[1]" DRIVE=8;

IO_LOC "led[2]" 17;
IO_PORT "led[2]" DRIVE=8;

IO_LOC "led[3]" 18;
IO_PORT "led[3]" DRIVE=8;

IO_LOC "led[4]" 19;
IO_PORT "led[4]" DRIVE=8;

IO_LOC "led[5]" 20;
IO_PORT "led[5]" DRIVE=8;
